<div class="container mt-4">
    <h2 class="text-center mb-4">📊 İstiklal Üniversitesi LoRaWAN LHT52 Sıcaklık ve Nem Sensörü Ölçüm Verileri</h2>

    <div class="row">
        <!-- Sıcaklık -->
        <div class="col-lg-6 col-12 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title text-center mb-3">🌡️ Sıcaklık (°C)</h4>
                    <div class="chart-container flex-grow-1" style="min-height:300px;">
                        <canvas id="temperatureChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nem -->
        <div class="col-lg-6 col-12 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title text-center mb-3">💧 Nem (%)</h4>
                    <div class="chart-container flex-grow-1" style="min-height:300px;">
                        <canvas id="humidityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js ve Firebase SDK scriptleri aynı -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-database-compat.js"></script>

<script>
    // 🔥 Firebase ayarları ve mevcut grafik kodun aynen duruyor
    const firebaseConfig = {
        databaseURL: "https://istiklal-karacasu-default-rtdb.europe-west1.firebasedatabase.app/"
    };
    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();
    const telemetryRef = db.ref("telemetry");

    const tempCtx = document.getElementById("temperatureChart").getContext("2d");
    const humCtx = document.getElementById("humidityChart").getContext("2d");

    const highlightLastValuePlugin = {
        id: 'highlightLastValue',
        afterDatasetsDraw(chart) {
            const {ctx} = chart;
            chart.data.datasets.forEach((dataset, datasetIndex) => {
                const meta = chart.getDatasetMeta(datasetIndex);
                if (!meta.data.length) return;

                const lastPoint = meta.data[meta.data.length - 1];
                const value = dataset.data[dataset.data.length - 1] ?? '0';

                const padding = 10;
                const fontSize = 20;
                ctx.save();
                ctx.font = `${fontSize}px sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';

                const boxWidth = ctx.measureText(value).width + padding * 2;
                const boxHeight = fontSize + padding * 2;
                const x = lastPoint.x;
                const y = lastPoint.y - 14;

                ctx.fillStyle = 'rgba(0,0,0,0.7)';
                ctx.fillRect(x - boxWidth / 2, y - boxHeight, boxWidth, boxHeight);

                ctx.fillStyle = 'white';
                ctx.fillText(value, x, y - padding / 2);

                ctx.restore();
            });
        }
    };

    const tempChart = new Chart(tempCtx, {
        type: "line",
        data: { labels: [], datasets: [{ label: "Sıcaklık (°C)", data: [], fill: true, backgroundColor: "rgba(255,99,132,0.15)", borderColor: "rgba(255,99,132,0.8)", tension: 0.3 }] },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: false } }, plugins: { legend: { position: "top" } } },
        plugins: [highlightLastValuePlugin]
    });

    const humChart = new Chart(humCtx, {
        type: "line",
        data: { labels: [], datasets: [{ label: "Nem (%)", data: [], fill: true, backgroundColor: "rgba(54,162,235,0.15)", borderColor: "rgba(54,162,235,0.8)", tension: 0.3 }] },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } }, plugins: { legend: { position: "top" } } },
        plugins: [highlightLastValuePlugin]
    });

    window.addEventListener("resize", () => { tempChart.resize(); humChart.resize(); });

    telemetryRef.limitToLast(200).on("child_added", snapshot => updateCharts(snapshot, "add"));
    telemetryRef.on("child_changed", snapshot => updateCharts(snapshot, "update"));
    telemetryRef.on("child_removed", snapshot => updateCharts(snapshot, "remove"));

    function updateCharts(snapshot, type) {
        const entry = snapshot.val();
        if (!entry || !entry.Time) return;

        const label = new Date(entry.Time).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });

        if (type === "add") {
            tempChart.data.labels.push(label);
            tempChart.data.datasets[0].data.push(entry.Temperature || 0);
            humChart.data.labels.push(label);
            humChart.data.datasets[0].data.push(entry.Humidity || 0);
        } else if (type === "update") {
            const idx = tempChart.data.labels.indexOf(label);
            if (idx >= 0) {
                tempChart.data.datasets[0].data[idx] = entry.Temperature || 0;
                humChart.data.datasets[0].data[idx] = entry.Humidity || 0;
            }
        } else if (type === "remove") {
            const idx = tempChart.data.labels.indexOf(label);
            if (idx >= 0) {
                tempChart.data.labels.splice(idx, 1);
                tempChart.data.datasets[0].data.splice(idx, 1);
                humChart.data.labels.splice(idx, 1);
                humChart.data.datasets[0].data.splice(idx, 1);
            }
        }

        if (tempChart.data.labels.length > 200) {
            tempChart.data.labels.shift();
            tempChart.data.datasets[0].data.shift();
        }
        if (humChart.data.labels.length > 200) {
            humChart.data.labels.shift();
            humChart.data.datasets[0].data.shift();
        }

        tempChart.update();
        humChart.update();
    }
</script>
