<!DOCTYPE html>
@{
    ViewData["Title"] = "Temperature and Humidity";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LoRaWAN LHT52 Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background-color: #121212;
            color: white;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .container-fluid {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card {
            background-color: #1e1e1e;
            border: 1px solid #333;
        }

        .card-title {
            color: #ffffff;
            font-weight: 700;
            text-shadow: 1px 1px 4px #000000;
        }

        .chart-container {
            flex-grow: 1;
            min-height: 40vh;
            max-height: none;
        }

        .badge-primary {
            background-color: #36a2eb;
        }

        .badge-normal {
            background-color: #00ff00;
            color: black;
        }

        .badge-danger {
            background-color: #ff3b30;
        }

        .card-body h2 {
            margin-bottom: 0.5rem;
        }

        .data-time-label {
            font-size: 0.9rem;
            color: #aaaaaa;
            text-align: center;
            margin: 4px 0;
        }
    </style>
</head>
<body>

    <div class="container-fluid mt-2 mb-2 text-white">

        @* <h2 class="text-center mb-3" style="color: olivedrab;">Climate Control</h2>*@

        <div class="row mb-2 flex-shrink-0">
            <div class="col-lg-6 col-md-6 col-12 mb-2">
                <div class="card shadow-lg h-100 d-flex align-items-center justify-content-center">
                    <div class="card-body text-center">
                        <h4 class="card-title mb-1">🌡️ Last Temperature</h4>
                        <h2 id="lastTemperature" style="text-shadow:0 0 8px #ffffff;">-- °C</h2>
                        <span id="tempStatus" class="badge" style="font-size:1rem;">--</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12 mb-2">
                <div class="card shadow-lg h-100 d-flex align-items-center justify-content-center">
                    <div class="card-body text-center">
                        <h4 class="card-title mb-1">💧 Last Humidity</h4>
                        <h2 id="lastHumidity" style="text-shadow:0 0 8px #ffffff;">-- %</h2>
                        <span id="humStatus" class="badge" style="font-size:1rem;">--</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="data-time-label" style="font-size: large; color: darkgoldenrod;" id="lastDataTime">--</div>

        <div class="row flex-grow-1" style="flex: 1;">
            <div class="col-lg-6 col-md-6 col-12 mb-2 d-flex flex-column">
                <div class="card shadow-lg flex-grow-1 d-flex flex-column">
                    <div class="card-body d-flex flex-column flex-grow-1">
                        <h4 class="card-title text-center mb-2">🌡️ Temperature (°C)</h4>
                        <div class="chart-container flex-grow-1">
                            <canvas id="temperatureChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12 mb-2 d-flex flex-column">
                <div class="card shadow-lg flex-grow-1 d-flex flex-column">
                    <div class="card-body d-flex flex-column flex-grow-1">
                        <h4 class="card-title text-center mb-2">💧 Humidity (%)</h4>
                        <div class="chart-container flex-grow-1">
                            <canvas id="humidityChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="data-time-label" style="font-size: small; color: darkgoldenrod;">The graphs contain the last 288 data points. Data is received every 10 minutes.</div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/11.0.1/firebase-database-compat.js"></script>

    <script>
        const firebaseConfig = { databaseURL: "https://istiklal-karacasu-default-rtdb.europe-west1.firebasedatabase.app/" };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        const telemetryRef = db.ref("telemetry");

        const tempCtx = document.getElementById("temperatureChart").getContext("2d");
        const humCtx = document.getElementById("humidityChart").getContext("2d");

        function getInterpolatedValue(dataArray, index) {
            if (dataArray[index] != null) return dataArray[index];
            let prev = null; let next = null;
            for (let i = index-1; i>=0; i--) if (dataArray[i]!=null){ prev=dataArray[i]; break; }
            for (let i = index+1; i<dataArray.length; i++) if (dataArray[i]!=null){ next=dataArray[i]; break; }
            if(prev!=null && next!=null) return (prev+next)/2;
            if(prev!=null) return prev;
            if(next!=null) return next;
            return 0;
        }

        function categorizeTemperature(t){ if(t<18) return {color:"#36a2eb"}; if(t<25) return {color:"#00ff00"}; return {color:"#ff3b30"}; }
        function categorizeHumidity(h){ if(h<30) return {color:"#36a2eb"}; if(h<60) return {color:"#00ff00"}; return {color:"#ff3b30"}; }

        const rangeBackgroundPlugin = {
            id:'rangeBackground',
            beforeDatasetsDraw(chart){
                const ctx = chart.ctx;
                const yScale = chart.scales.y;
                const xScale = chart.scales.x;
                const ranges = chart.canvas.id==="temperatureChart"
                    ? [{min:0,max:17,color:"rgba(54,162,235,0.1)"},{min:18,max:24,color:"rgba(0,255,0,0.1)"},{min:25,max:50,color:"rgba(255,59,48,0.1)"}]
                    : [{min:0,max:29,color:"rgba(54,162,235,0.1)"},{min:30,max:59,color:"rgba(0,255,0,0.1)"},{min:60,max:100,color:"rgba(255,59,48,0.1)"}];
                ranges.forEach(r=>{
                    const top=yScale.getPixelForValue(r.max);
                    const bottom=yScale.getPixelForValue(r.min);
                    ctx.fillStyle=r.color;
                    ctx.fillRect(xScale.left,top,xScale.width,bottom-top);
                });
            }
        };

        const colorSegmentPlugin = {
            id: 'colorSegment',
            beforeDatasetDraw(chart){
                const dataset = chart.data.datasets[0];
                const meta = chart.getDatasetMeta(0);
                const ctx = chart.ctx;
                ctx.save();
                for(let i=0; i<meta.data.length-1; i++){
                    const p1 = meta.data[i].getProps(['x','y'],true);
                    const p2 = meta.data[i+1].getProps(['x','y'],true);
                    const val = dataset.data[i].yValue;
                    const color = chart.canvas.id==="temperatureChart" ? categorizeTemperature(val).color : categorizeHumidity(val).color;
                    ctx.strokeStyle = color;
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    ctx.moveTo(p1.x,p1.y);
                    ctx.lineTo(p2.x,p2.y);
                    ctx.stroke();
                }
                ctx.restore();
                return false;
            }
        };

        function createChart(ctx, maxY){
            return new Chart(ctx, {
                type: 'line',
                data: {
                    datasets:[{
                        data:[],
                        parsing: {xAxisKey:'xValue', yAxisKey:'yValue'},
                        label:"",
                        fill:true,
                        backgroundColor:'transparent',
                        borderColor:'transparent',
                        pointRadius:3
                    }]
                },
                options:{
                    responsive:true,
                    maintainAspectRatio:false,
                    scales:{
                        x:{
                            ticks:{
                                color:"white",
                                autoSkip:true,
                                maxTicksLimit: 20, // Ekranda en fazla 20 tarih göster (kalabalığı önler)
                                minRotation: 90,
                                maxRotation: 90
                            },
                            grid:{ color:"rgba(255,255,255,0.05)" }
                        },
                        y:{ beginAtZero:true, max:maxY, ticks:{ color:"white" }, grid:{ color:"rgba(255,255,255,0.1)" } }
                    },
                    plugins:{
                        legend:{display:false},
                        tooltip:{
                            callbacks:{
                                label: function(context){
                                    const val = context.raw.yValue.toFixed(1);
                                    const originalTime = context.raw.rawTime;
                                    return val + " (" + new Date(originalTime).toLocaleString('tr-TR') + ")";
                                }
                            }
                        }
                    }
                },
                plugins:[rangeBackgroundPlugin,colorSegmentPlugin]
            });
        }

        const tempChart = createChart(tempCtx, 50);
        const humChart = createChart(humCtx, 100);
        window.addEventListener("resize", ()=>{ tempChart.resize(); humChart.resize(); });

        // Güncellenmiş Etiket Fonksiyonu: Artık 3 saatlik blok yerine gerçek saati gösteriyor
        function getHourLabel(date){
            const day = date.getDate().toString().padStart(2, '0');
            const month = (date.getMonth() + 1).toString().padStart(2, '0');
            const hours = date.getHours().toString().padStart(2, '0');
            const minutes = date.getMinutes().toString().padStart(2, '0');
            // Format: Gün/Ay Saat:Dakika (Örn: 08/12 14:30)
            return `${day}/${month} ${hours}:${minutes}`;
        }

        // Firebase verileri
        telemetryRef.limitToLast(288).on("child_added", s=>updateCharts(s,"add"));
        telemetryRef.on("child_changed", s=>updateCharts(s,"update"));
        telemetryRef.on("child_removed", s=>updateCharts(s,"remove"));

        function updateCharts(snapshot,type){
            const entry = snapshot.val();
            if(!entry || !entry.Time) return;
            const date = new Date(entry.Time);
            const label = getHourLabel(date);

            if(type==="add"){
                tempChart.data.labels.push(label);
                humChart.data.labels.push(label);
                tempChart.data.datasets[0].data.push({xValue:label, yValue:entry.Temperature ?? null, rawTime: entry.Time});
                humChart.data.datasets[0].data.push({xValue:label, yValue:entry.Humidity ?? null, rawTime: entry.Time});
            } else {
                const idx = tempChart.data.labels.indexOf(label);
                if(idx>=0){
                    tempChart.data.datasets[0].data[idx].yValue = entry.Temperature ?? tempChart.data.datasets[0].data[idx].yValue;
                    tempChart.data.datasets[0].data[idx].rawTime = entry.Time ?? tempChart.data.datasets[0].data[idx].rawTime;
                    humChart.data.datasets[0].data[idx].yValue = entry.Humidity ?? humChart.data.datasets[0].data[idx].yValue;
                    humChart.data.datasets[0].data[idx].rawTime = entry.Time ?? humChart.data.datasets[0].data[idx].rawTime;
                }
            }

            // Interpolasyon
            tempChart.data.datasets[0].data = tempChart.data.datasets[0].data.map((v,i,a)=> v.yValue!=null ? v : {yValue:getInterpolatedValue(a.map(d=>d.yValue),i), xValue:v?.xValue, rawTime:v?.rawTime});
            humChart.data.datasets[0].data = humChart.data.datasets[0].data.map((v,i,a)=> v.yValue!=null ? v : {yValue:getInterpolatedValue(a.map(d=>d.yValue),i), xValue:v?.xValue, rawTime:v?.rawTime});

            if(tempChart.data.labels.length>432){ tempChart.data.labels.shift(); tempChart.data.datasets[0].data.shift(); }
            if(humChart.data.labels.length>432){ humChart.data.labels.shift(); humChart.data.datasets[0].data.shift(); }

            const lastTemp = tempChart.data.datasets[0].data[tempChart.data.datasets[0].data.length-1].yValue;
            const lastHum = humChart.data.datasets[0].data[humChart.data.datasets[0].data.length-1].yValue;

            document.getElementById("lastTemperature").innerText = lastTemp.toFixed(1)+" °C";
            document.getElementById("lastTemperature").style.color = categorizeTemperature(lastTemp).color;
            document.getElementById("tempStatus").innerText = lastTemp<18 ? "Faculty Cold" : lastTemp<25 ? "Faculty Suitable" : "Faculty Hot";
            document.getElementById("tempStatus").className="badge " + (lastTemp<18?"badge-primary":lastTemp<25?"badge-normal":"badge-danger");

            document.getElementById("lastHumidity").innerText = lastHum.toFixed(1)+" %";
            document.getElementById("lastHumidity").style.color = categorizeHumidity(lastHum).color;
            document.getElementById("humStatus").innerText = lastHum<30 ? "Humidity Low" : lastHum<60 ? "Humidity Normal" : "Humidity High";
            document.getElementById("humStatus").className="badge " + (lastHum<30?"badge-primary":lastHum<60?"badge-normal":"badge-danger");

            document.getElementById("lastDataTime").innerText = "Last Received Data: " + date.toLocaleString('tr-TR');

            tempChart.update();
            humChart.update();
        }
    </script>

</body>