@{
    ViewData["Title"] = "Canlı Takip";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Canlı GPS Takip</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* --- GENEL AYARLAR --- */
        body {
            margin: 0; padding: 0; overflow: hidden; /* Scroll yok */
            background-color: #f4f6f9;
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex; flex-direction: column;
        }

        /* --- ÜST MENÜ ÇUBUĞU (NAVBAR) --- */
        .navbar {
            background-color: #2c3e50 !important; height: 40px; min-height: 40px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 3000; padding: 0 15px;
            flex-shrink: 0;
            display: flex; justify-content: space-between; align-items: center;
        }
        
        /* SOL TARAFTAKİ LİNK STİLİ */
        .navbar-brand { 
            color: #fff !important; 
            font-size: 14px; 
            font-weight: 600; 
            line-height: 40px; 
            padding: 0; 
            margin: 0;
            text-decoration: none; /* Link alt çizgisini kaldır */
            cursor: pointer;
        }
        .navbar-brand:hover {
            color: rgba(255, 255, 255, 0.8) !important;
        }

        /* SAĞ TARAFTAKİ HAVA DURUMU LINKI */
        .weather-link {
            color: rgba(255,255,255,0.9); text-decoration: none; font-size: 13px; font-weight: 500;
            display: flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 4px;
            background-color: rgba(255, 255, 255, 0.1); transition: background 0.2s;
        }
        .weather-link:hover { color: #fff; background-color: rgba(255, 255, 255, 0.2); }

        /* --- HARİTA VE SIDEBAR KONTEYNERİ --- */
        .dashboard-container {
            flex-grow: 1; /* Navbar'dan kalan alanı doldur */
            display: flex;
            position: relative;
            overflow: hidden;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 320px;
            background: #fff;
            border-right: 1px solid #dee2e6;
            display: flex; flex-direction: column;
            z-index: 2000;
            box-shadow: 2px 0 5px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
        }

        .sidebar-header {
            padding: 12px 15px;
            background: #fff; 
            border-bottom: 1px solid #eee;
            color: #2c3e50;
            display: flex; justify-content: space-between; align-items: center;
        }
        .sidebar-title { font-size: 14px; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px; }

        .device-list-container {
            flex-grow: 1; overflow-y: auto; padding: 10px; background-color: #f8f9fa;
        }

        /* --- HARİTA --- */
        #map { flex-grow: 1; height: 100%; z-index: 1; }

        /* --- KART TASARIMI --- */
        .device-card {
            background: white; padding: 12px; margin-bottom: 10px; border-radius: 8px;
            border-left: 4px solid #ccc; box-shadow: 0 2px 5px rgba(0,0,0,0.03);
            cursor: pointer; transition: all 0.2s; border: 1px solid #e1e4e8; border-left-width: 4px;
        }
        .device-card:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.08); }

        .border-active { border-left-color: #28a745 !important; }
        .border-error { border-left-color: #dc3545 !important; }

        .status-badge { font-size: 10px; padding: 3px 8px; border-radius: 12px; font-weight: 600; }
        .status-ok { background-color: #d1e7dd; color: #0f5132; }
        .status-err { background-color: #f8d7da; color: #842029; }

        /* MOBİL MENÜ BUTONU */
        #mobile-menu-btn {
            display: none; position: absolute; top: 15px; left: 15px; z-index: 2500;
            background: #fff; border: 1px solid #ccc; color: #333;
        }

        /* --- MOBİL UYUMLULUK --- */
        @@media (max-width: 768px) {
            .sidebar { position: absolute; height: 100%; width: 85%; transform: translateX(-100%); top: 0; left: 0; }
            .sidebar.active { transform: translateX(0); }
            #mobile-menu-btn { display: block !important; }
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark">
        <div class="container-fluid d-flex justify-content-between">
            
            <a href="/Home/Index" class="navbar-brand">
                Kahramanmaraş İstiklal University MMTF Smart Faculty
            </a>
            
            <a href="/Home/havadurumu" class="weather-link">
                🌡️ Temperature & Humidity
            </a>
        </div>
    </nav>

    <div class="dashboard-container">
        
        <button id="mobile-menu-btn" class="btn btn-sm shadow-sm" onclick="window.toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <h5 class="sidebar-title"><i class="fas fa-satellite-dish text-primary"></i> Cihaz Listesi (<span id="device-count">0</span>)</h5>
                <button class="btn btn-sm btn-light d-md-none" onclick="window.toggleSidebar()"><i class="fas fa-times"></i></button>
            </div>

            <div class="px-3 py-2 bg-white border-bottom text-center">
                <small id="connection-status" class="text-muted" style="font-size:11px">Bağlanıyor...</small>
            </div>

            <div id="device-list" class="device-list-container">
                <div class="text-center mt-5 text-muted">
                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                    <p class="mt-2" style="font-size:12px">Veriler yükleniyor...</p>
                </div>
            </div>
        </div>

        <div id="map"></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getDatabase, ref, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

        // Firebase Ayarları
        const firebaseConfig = {
            databaseURL: "https://istiklal-karacasu-default-rtdb.europe-west1.firebasedatabase.app/"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);
        const dbRef = ref(db, 'locations');

        // Harita Kurulumu
        var map = L.map('map').setView([37.5753, 36.9228], 13); // Karacasu Merkez
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        var markers = {};

        // Veri Dinleme
        onValue(dbRef, (snapshot) => {
            const data = snapshot.val();
            const listDiv = document.getElementById("device-list");
            const countSpan = document.getElementById("device-count");
            const statusSpan = document.getElementById("connection-status");

            statusSpan.innerHTML = '<i class="fas fa-wifi text-success"></i> Canlı Bağlantı';

            if (!data) {
                listDiv.innerHTML = "<div class='text-center p-4 text-muted' style='font-size:12px'>Aktif cihaz bulunamadı.</div>";
                countSpan.innerText = "0";
                return;
            }

            const keys = Object.keys(data);
            countSpan.innerText = keys.length;

            let listHtmlBuffer = "";

            keys.forEach(key => {
                const record = data[key];
                const lat = record.lat || 0;
                const lng = record.lng || 0;
                const devName = record.device_name || "Bilinmeyen Cihaz";
                const bat = record.battery || 0;
                const time = record.last_update || "-";
                const status = record.status || "Aktif";

                const isGpsValid = (lat !== 0 && lng !== 0);

                // --- HARİTA GÜNCELLEME ---
                if (isGpsValid) {
                    const popupContent = `
                        <div style="text-align:center; font-family:'Inter',sans-serif;">
                            <strong>${devName}</strong><br>
                            <span class="badge bg-secondary" style="font-size:10px">${time}</span>
                            <hr style="margin:5px 0">
                            <div style="display:flex; justify-content:space-between; font-size:11px">
                                <span>Pil: %${bat}</span>
                                <span>${status}</span>
                            </div>
                        </div>`;

                    if (markers[key]) {
                        markers[key].setLatLng([lat, lng]);
                        markers[key].setPopupContent(popupContent);
                    } else {
                        const newMarker = L.marker([lat, lng]).addTo(map);
                        newMarker.bindPopup(popupContent);
                        newMarker.bindTooltip(devName, { permanent: false, direction: 'top', className: 'bg-transparent border-0 fw-bold shadow-none' });
                        markers[key] = newMarker;
                    }
                }

                // --- LİSTE GÜNCELLEME ---
                let borderClass = isGpsValid && status === "Aktif" ? "border-active" : "border-error";
                let statusBadgeClass = isGpsValid && status === "Aktif" ? "status-ok" : "status-err";
                let batIcon = "fa-battery-full";
                let batColor = "text-success";
                if(bat < 50) { batIcon = "fa-battery-half"; batColor = "text-warning"; }
                if(bat < 20) { batIcon = "fa-battery-empty"; batColor = "text-danger"; }

                listHtmlBuffer += `
                    <div class="device-card ${borderClass}" onclick="window.focusDevice(${lat}, ${lng}, '${key}')">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="m-0 fw-bold" style="font-size:13px; color:#333">${devName}</h6>
                            <span class="${batColor} fw-bold" style="font-size:11px"><i class="fas ${batIcon}"></i> %${bat}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="status-badge ${statusBadgeClass}">
                                ${status}
                            </span>
                            <small class="text-muted" style="font-size:10px">${time}</small>
                        </div>
                    </div>
                `;
            });

            listDiv.innerHTML = listHtmlBuffer;
        });

        // --- GLOBAL FONKSİYONLAR ---
        window.toggleSidebar = function() {
            document.getElementById('sidebar').classList.toggle('active');
        };

        window.focusDevice = function(lat, lng, key) {
            if (!lat || !lng || lat === 0 || lng === 0) {
                alert("GPS verisi yok.");
                return;
            }
            map.flyTo([lat, lng], 16, { animate: true, duration: 1.5 });
            if(markers[key]) { setTimeout(() => { markers[key].openPopup(); }, 1500); }
            if (window.innerWidth <= 768) { document.getElementById('sidebar').classList.remove('active'); }
        };
    </script>
</body>
</html>