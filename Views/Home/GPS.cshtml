@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İstiklal LoRaWAN | GPS Tracking</title>
    
    <!-- Bootstrap 5: Sayfadaki görsel tasarım için (kutu yapıları, butonlar vb.) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome: İkonlar için -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter yazı tipi -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/assets/css/style.css">
    
    <!-- Firebase SDK: Veritabanına bağlanmak için -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
    
    <!-- Leaflet JS: GPS haritasını ve üzerindeki noktaları çizmemizi sağlayan kütüphane -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>
    <!-- Üst Menü -->
    <nav>
        <a href="/Home/Index" class="navbar-brand">İstiklal LoRaWAN</a>
        <div class="nav-links">
            <a href="/Home/havadurumu"><i class="fas fa-thermometer-half"></i> Temp & Humidity</a>
        </div>
    </nav>

    <!-- Asıl İçerik Alanı -->
    <div class="dashboard-container">
        <!-- 1. BÖLÜM: Sol Taraftaki Yan Menü (Sidebar) -->
        <div class="sidebar">
            
            <!-- A. Cihazların Listelendiği Görünüm -->
            <div id="view-devices" style="display:flex; flex-direction:column; height:100%;">
                <div class="sidebar-header">
                    <i class="fas fa-satellite-dish text-primary"></i> Device List (<span id="device-count">0</span>)
                </div>
                <!-- Cihaz kutucukları buraya Javascript ile eklenecek -->
                <div class="device-list-container" id="device-list">
                    <div class="text-center mt-5 text-muted">
                        <p style="font-size:12px">Loading data...</p>
                    </div>
                </div>
            </div>

            <!-- B. Bir Cihazın Geçmişinin (Rotalarının) Gösterildiği Görünüm (Başlangıçta Gizli) -->
            <div id="view-history" style="display:none; flex-direction:column; height:100%; background:#f8f9fa;">
                <div class="sidebar-header bg-light d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <!-- Geri Dön Butonu -->
                        <button class="btn btn-sm btn-outline-secondary me-2 border-0" onclick="closeHistory()">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <span id="history-title-device" style="font-size:13px; font-weight:700">History</span>
                    </div>
                </div>
                <div class="px-3 py-2 bg-white border-bottom text-center">
                    <!-- Rotayı Kaydetmeyi Başlatma/Durdurma Butonu -->
                    <button id="toggle-record-btn" class="btn btn-sm btn-outline-primary w-100" style="font-size:11px">
                        <i class="fas fa-play"></i> Start Recording
                    </button>
                </div>
                <!-- Geçmiş Rota (Oturum) Kayıtları Buraya Eklenecek -->
                <div id="history-list" class="device-list-container">
                    <!-- Geçmiş rotalar buraya gelir -->
                </div>
            </div>
        </div>

        <!-- 2. BÖLÜM: Sağ Taraftaki Harita Alanı -->
        <div id="map"></div>
    </div>

    <!-- Veritabanı şifreleri -->
    <script src="~/assets/js/firebase-config.js"></script>
    <script>
        // --- 1. HARİTAYI BAŞLATMA ---
        // Kahramanmaraş Karacasu koordinatlarında (37.5170, 36.9922) haritayı aç
        let map = L.map('map', { zoomControl: false }).setView([37.5170, 36.9922], 13);
        L.control.zoom({ position: 'bottomright' }).addTo(map); // Yakınlaştırma butonunu sağ alta koy
        // OpenStreetMap (Ücretsiz harita sağlayıcısı) katmanını haritaya ekle
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // Harita üzerindeki işaretçileri, çizgileri hafızada tutacağımız değişkenler
        let markers = {}; 
        let selectedDevice = null; // Şu an tıklanan cihaz
        let currentPolyline = null; // Haritaya çizilen mavi çizgi (Rota)
        let currentHistoryDevice = null; // Geçmişi izlenen cihaz
        let currentDrawnSessionId = null; // Şu an haritada çizili olan oturum
        let startMarker = null; // Rotanın başladığı yer
        let endMarker = null; // Rotanın bittiği yer

        // Gelen konum (enlem, boylam) değerinin gerçekten Dünya üzerinde mantıklı bir yer olup olmadığını kontrol eder
        function isValidLocation(lat, lng) {
            if (lat === null || lng === null || lat === undefined || lng === undefined) return false;
            if (lat === 0 && lng === 0) return false; // Cihaz uydu bulamayınca 0,0 yollar
            if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return false; // Dünyanın sınırları dışındaysa geçersiz
            return true;
        }

        // --- 2. FİREBASE'İ (VERİTABANINI) DİNLEME ---
        // Veritabanındaki "devices" kısmında bir değişiklik oldukça anında burası çalışır
        database.ref('devices').on('value', snapshot => {
            const devices = snapshot.val();
            updateDeviceList(devices); // Sol taraftaki cihaz listesini güncelle
            updateMarkers(devices); // Haritadaki iğnelerin (marker) yerini güncelle

            // Eğer şu an bir cihazın geçmişine (rotasına) bakıyorsak, geçmiş listesini de güncelle
            if (currentHistoryDevice && document.getElementById('view-history').style.display === 'flex') {
                if (devices && devices[currentHistoryDevice]) {
                    try {
                        updateHistoryUI(currentHistoryDevice, devices[currentHistoryDevice]);
                    } catch (e) {
                        console.error("Error updating history:", e);
                    }
                }
            }
        });

        // --- SOL TARAFTAKI CİHAZ LİSTESİNİ OLUŞTURMA ---
        function updateDeviceList(devices) {
            const container = document.getElementById('device-list');
            const countSpan = document.getElementById('device-count');
            container.innerHTML = ''; // Önce eski listeyi sil
            let count = 0;

            for (let id in devices) {
                const dev = devices[id];
                // Sadece GPS tipi cihazları listele, Isı/Nem sensörlerini geç
                if (dev.info.type !== 'gps') continue;
                count++;

                // Eğer son veri 5 dakika (300.000 ms) içindeyse AKTİF say, değilse PASİF
                const isActive = (new Date() - new Date(dev.info.last_seen)) < 300000;
                const borderClass = isActive ? 'border-active' : 'border-error';
                
                // Cihazın listeleneceği kutucuğu (HTML) oluştur
                const div = document.createElement('div');
                div.className = `device-card ${borderClass}`;
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="m-0 fw-bold" style="font-size:13px; color:#333">${dev.info.name}</h6>
                        <span class="text-success fw-bold" style="font-size:11px"><i class="fas fa-battery-full"></i> ${dev.info.battery}%</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge ${isActive ? 'bg-success' : 'bg-danger'}" style="font-size:10px">${isActive ? 'Active' : 'Inactive'}</span>
                        <small class="text-muted" style="font-size:10px">${new Date(dev.info.last_seen).toLocaleTimeString('en-US')}</small>
                    </div>
                `;
                // Bu kutuya tıklanınca ne olacağını belirle (Cihazı seç ve haritada oraya git)
                div.onclick = () => selectDevice(id, dev);
                container.appendChild(div); // Kutuyu ekrana ekle
            }
            countSpan.innerText = count; // Toplam sayıyı yukarıya yaz
        }

        // --- HARİTA ÜZERİNDEKİ İĞNELERİ (MARKER) YERLEŞTİRME ---
        function updateMarkers(devices) {
            for (let id in devices) {
                const dev = devices[id];
                if (dev.info.type !== 'gps' || !dev.latest) continue; // Sadece GPS cihazı ise devam et

                const { lat, lng } = dev.latest; // Cihazın en son enlem boylamını al
                if (!isValidLocation(lat, lng)) continue; // Koordinat hatalıysa haritada gösterme
                
                // Şu an bu cihazın yolu veritabanına kaydediliyor mu?
                const isTracking = dev.settings && String(dev.settings.record_path) === 'true';

                // İğneye tıklayınca açılacak küçük bilgi kutucuğunun (Popup) tasarımı
                const popupContent = `
                    <div style="text-align:center; font-family:'Inter',sans-serif;">
                        <strong>${dev.info.name}</strong><br>
                        <small class="text-muted">${new Date(dev.info.last_seen).toLocaleString('en-US')}</small>
                        <hr style="margin:8px 0">
                        <div class="d-grid gap-1">
                            <!-- Kaydı Başlat/Durdur Butonu -->
                            <button class="btn btn-sm ${isTracking ? 'btn-danger' : 'btn-success'}" style="font-size:11px" onclick="toggleRecording('${id}', ${!isTracking})">
                                <i class="fas ${isTracking ? 'fa-stop' : 'fa-play'}"></i> ${isTracking ? 'Stop Recording' : 'Start Recording'}
                            </button>
                            <!-- Geçmişi Gör Butonu -->
                            <button class="btn btn-sm btn-primary" style="font-size:11px" onclick="openHistoryView('${id}')">
                                <i class="fas fa-history"></i> View History
                            </button>
                        </div>
                    </div>
                `;

                // Eğer iğne zaten haritada varsa, sadece yerini ve içindeki yazıyı güncelle
                if (markers[id]) {
                    markers[id].setLatLng([lat, lng]).setPopupContent(popupContent);
                } else {
                    // Yoksa haritaya yeni bir iğne (Marker) ekle
                    markers[id] = L.marker([lat, lng]).addTo(map).bindPopup(popupContent);
                }
            }
        }

        // --- BİR CİHAZA TIKLANINCA HARİTAYI ORAYA KAYDIRMA ---
        function selectDevice(id, dev) {
            selectedDevice = id;
            if (dev.latest && isValidLocation(dev.latest.lat, dev.latest.lng)) {
                // map.flyTo: Haritayı yumuşak bir animasyonla o noktaya uçurur
                map.flyTo([dev.latest.lat, dev.latest.lng], 16);
                // Yarım saniye bekle ve sonra iğnenin üzerindeki bilgi baloncuğunu aç
                if (markers[id]) setTimeout(() => markers[id].openPopup(), 500);
            }
        }

        // --- GEÇMİŞ GÖRÜNÜMÜNÜ (SOL MENÜ) AÇMA ---
        window.openHistoryView = function(id) {
            document.getElementById('view-devices').style.display = 'none'; // Cihaz listesini gizle
            document.getElementById('view-history').style.display = 'flex'; // Geçmiş listesini göster
            currentHistoryDevice = id;
            
            // Tıklanan cihazın verilerini veritabanından bir kereye mahsus çek ve arayüzü oluştur
            database.ref(`devices/${id}`).once('value', snapshot => {
                updateHistoryUI(id, snapshot.val());
            });
        };

        // --- GEÇMİŞ MENÜSÜNÜN İÇİNİ DOLDURMA ---
        function updateHistoryUI(id, dev) {
            if (!dev) return;
            document.getElementById('history-title-device').innerText = dev.info.name + " History"; // Üst başlığı değiştir
            
            // Cihaz o an kayıt altında mı kontrol et
            const isRecording = dev.settings && String(dev.settings.record_path) === 'true';
            const activeSessionId = dev.settings ? dev.settings.current_session_id : null;
            
            // Üstteki mavi "Kaydı Başlat / Durdur" butonunun rengini ve yazısını ayarla
            const btn = document.getElementById('toggle-record-btn');
            btn.innerHTML = isRecording ? '<i class="fas fa-stop"></i> Stop Recording' : '<i class="fas fa-play"></i> Start Recording';
            btn.className = isRecording ? 'btn btn-sm btn-danger w-100' : 'btn btn-sm btn-outline-primary w-100';
            btn.onclick = () => toggleRecording(id, !isRecording);

            // Geçmiş oturumların listesini sol tarafa çizdir
            renderHistoryList(dev.history);

            // Eğer şu an bir rotayı kaydediyorsa (Canlı izleme), o rotayı haritaya çizmeye başla
            if (isRecording && activeSessionId && dev.history && dev.history[activeSessionId]) {
                if (!currentDrawnSessionId) {
                    currentDrawnSessionId = activeSessionId;
                    const records = Object.values(dev.history[activeSessionId])
                                          .filter(r => isValidLocation(r.lat, r.lng))
                                          .sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));
                    drawSessionPath(records, activeSessionId, false);
                    return;
                }
            }

            // Ya da halihazırda çizilmiş eski bir rotayı inceliyorsak onu güncelle
            if (currentDrawnSessionId && dev.history && dev.history[currentDrawnSessionId]) {
                const records = Object.values(dev.history[currentDrawnSessionId])
                                      .filter(r => isValidLocation(r.lat, r.lng))
                                      .sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));
                drawSessionPath(records, currentDrawnSessionId, true);
            }
        }

        // --- GEÇMİŞ KAYITLARI (OTURUMLARI) SOL TARAFA LİSTELEME ---
        function renderHistoryList(history) {
            const container = document.getElementById('history-list');
            container.innerHTML = '';
            // Eğer hiç geçmiş yoksa uyar
            if (!history) {
                container.innerHTML = '<div class="text-center p-4 text-muted" style="font-size:12px">No records found.</div>';
                return;
            }

            // Kayıt oturumlarının isimlerini al ve en yenisi en üstte çıkacak şekilde ters çevir
            const sessionIds = Object.keys(history).reverse();

            if (sessionIds.length === 0) {
                container.innerHTML = '<div class="text-center p-4 text-muted" style="font-size:12px">No session records found.</div>';
                return;
            }

            // Her bir oturum için bir kutucuk oluştur
            sessionIds.forEach(sessionId => {
                const sessionData = history[sessionId];
                // Bu oturumdaki tüm nokta verilerini eskiden yeniye doğru sıraya diz
                const records = Object.values(sessionData)
                                      .filter(r => isValidLocation(r.lat, r.lng))
                                      .sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));
                if(records.length === 0) return;
                
                // HESAPLAMALAR: Başlangıç Saati, Bitiş Saati
                const startTimeMs = new Date(records[0].timestamp).getTime();
                const endTimeMs = new Date(records[records.length-1].timestamp).getTime();
                const startTime = new Date(startTimeMs).toLocaleString('en-US');
                const endTime = new Date(endTimeMs).toLocaleTimeString('en-US');
                
                // HESAPLAMALAR: Toplam Alınan Mesafe
                let totalDistance = 0;
                for (let i = 0; i < records.length - 1; i++) {
                    const p1 = L.latLng(records[i].lat, records[i].lng); // Birinci nokta
                    const p2 = L.latLng(records[i+1].lat, records[i+1].lng); // İkinci nokta
                    totalDistance += p1.distanceTo(p2); // İkisi arası mesafeyi (metre) ekle
                }
                
                // Metreyi kilometreye çevir
                const distanceKm = totalDistance / 1000;
                const distanceStr = totalDistance < 1000 ? `${Math.round(totalDistance)} m` : `${distanceKm.toFixed(2)} km`;
                
                // HESAPLAMALAR: Geçen Süre
                const durationMs = endTimeMs - startTimeMs;
                const durationHours = durationMs / (1000 * 60 * 60);
                
                // HESAPLAMALAR: Ortalama Hız = Mesafe / Zaman
                let avgSpeed = 0;
                if (durationHours > 0) {
                    avgSpeed = distanceKm / durationHours;
                }
                
                // Geçen süreyi saat, dakika, saniye cinsine dönüştür
                let durationStr = "0 sn";
                if (durationMs > 0) {
                    const totalSec = Math.floor(durationMs / 1000);
                    const h = Math.floor(totalSec / 3600);
                    const m = Math.floor((totalSec % 3600) / 60);
                    const s = totalSec % 60;
                    let parts = [];
                    if (h > 0) parts.push(`${h} h`);
                    if (m > 0 || h > 0) parts.push(`${m} m`);
                    parts.push(`${s} s`);
                    durationStr = parts.join(' ');
                }
                
                // Sol taraftaki listeye kutuyu ekleme
                const div = document.createElement('div');
                div.className = 'device-card mb-2';
                // Eğer bu oturum şu an haritada çiziliyse, etrafını mavi yap
                if (currentDrawnSessionId === sessionId) {
                    div.classList.add('border', 'border-primary');
                }
                div.style.padding = '10px';
                div.style.cursor = 'pointer';
                // Kutuya tıklanınca o rotayı haritaya çizmesini söyle
                div.onclick = () => {
                    document.querySelectorAll('#history-list .device-card').forEach(el => el.classList.remove('border', 'border-primary'));
                    div.classList.add('border', 'border-primary');
                    drawSessionPath(records, sessionId, false);
                };
                
                // Kutunun içine hesapladığımız verileri yaz
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <div style="font-size:12px; font-weight:600; color:#333;">
                            <i class="fas fa-route text-primary me-1"></i> Start: ${startTime}
                        </div>
                        <span class="badge bg-secondary" style="font-size:10px">${records.length} Points</span>
                    </div>
                    <div style="font-size:11px; color:#666; margin-left: 20px; margin-bottom: 4px;">
                        End: ${endTime}
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="font-size:11px; color:#444;">
                        <div title="Total Distance"><i class="fas fa-ruler text-secondary"></i> ${distanceStr}</div>
                        <div title="Duration"><i class="fas fa-clock text-secondary"></i> ${durationStr}</div>
                        <div title="Average Speed"><i class="fas fa-tachometer-alt text-secondary"></i> ${avgSpeed.toFixed(1)} km/h</div>
                    </div>
                `;
                
                container.appendChild(div);
            });
        }

        // --- HARİTAYA MAVİ ROTAYI (ÇİZGİYİ) ÇİZME FONKSİYONU ---
        window.drawSessionPath = function(records, sessionId, isUpdate = false) {
            currentDrawnSessionId = sessionId;
            // Eski bir çizgi, yeşil bayrak (başlangıç) veya kırmızı bayrak (bitiş) varsa haritadan sil
            if (currentPolyline) map.removeLayer(currentPolyline);
            if (startMarker) map.removeLayer(startMarker);
            if (endMarker) map.removeLayer(endMarker);
            
            if (!records || records.length === 0) return;

            // Bütün geçmiş koordinatları tek bir dizi (array) içine topla
            const latlngs = records.map(r => [r.lat, r.lng]);
            
            // Tüm bu koordinatları birleştiren mavi (color: #0d6efd) kalın (weight: 4) bir çizgi (Polyline) çiz
            currentPolyline = L.polyline(latlngs, {color: '#0d6efd', weight: 4, opacity: 0.8}).addTo(map);
            
            // Başlangıç için yeşil bir ikon tasarımı
            const startIcon = L.divIcon({
                html: '<div style="font-size: 24px; color: #198754; text-shadow: 1px 1px 2px white;"><i class="fas fa-flag"></i></div>',
                className: '',
                iconSize: [24, 24],
                iconAnchor: [6, 24]
            });
            
            // Bitiş için kırmızı bir ikon tasarımı
            const endIcon = L.divIcon({
                html: '<div style="font-size: 24px; color: #dc3545; text-shadow: 1px 1px 2px white;"><i class="fas fa-flag-checkered"></i></div>',
                className: '',
                iconSize: [24, 24],
                iconAnchor: [6, 24]
            });

            // İlk konuma yeşil bayrağı yerleştir
            startMarker = L.marker(latlngs[0], {icon: startIcon}).addTo(map)
                .bindPopup(`<div style="text-align:center; font-family:'Inter',sans-serif;"><b>Start</b><br><small>${new Date(records[0].timestamp).toLocaleString('en-US')}</small></div>`);
                
            // Eğer birden fazla nokta varsa, en sonuncu konuma da kırmızı bayrağı yerleştir
            if (latlngs.length > 1) {
                endMarker = L.marker(latlngs[latlngs.length - 1], {icon: endIcon}).addTo(map)
                    .bindPopup(`<div style="text-align:center; font-family:'Inter',sans-serif;"><b>End / Last Position</b><br><small>${new Date(records[records.length - 1].timestamp).toLocaleString('en-US')}</small></div>`);
            }
            
            // Haritayı kamerasıyla bu çizginin tam ortasına getir ve sığacak kadar uzaklaştır (fitBounds)
            if (!isUpdate) {
                if (latlngs.length > 1) {
                    map.fitBounds(currentPolyline.getBounds(), { padding: [30, 30] });
                } else {
                    map.setView(latlngs[0], 17); // Tek nokta varsa sadece oraya yakınlaş
                }
            }
        };

        // --- GEÇMİŞ MENÜSÜNÜ KAPATMA FONKSİYONU ---
        window.closeHistory = function() {
            document.getElementById('view-history').style.display = 'none'; // Geçmişi gizle
            document.getElementById('view-devices').style.display = 'flex'; // Cihaz listesini göster
            currentHistoryDevice = null;
            currentDrawnSessionId = null;
            
            // Haritadaki rotayı ve bayrakları sil, temizle
            if (currentPolyline) { map.removeLayer(currentPolyline); currentPolyline = null; }
            if (startMarker) { map.removeLayer(startMarker); startMarker = null; }
            if (endMarker) { map.removeLayer(endMarker); endMarker = null; }
        };

        // --- KAYIT BAŞLAT / DURDUR (FIREBASE'E SÖYLEME) ---
        window.toggleRecording = function(devEui, enabled) {
            // Veritabanına göndereceğimiz ayarlar paketi
            let updates = { record_path: enabled }; // record_path = true (Kaydet) veya false (Kapat)
            
            // Eğer "Kaydet" dediysek, şu anki zamanı kullanarak yeni bir oturum adı (session_id) uydur
            if (enabled) {
                updates.current_session_id = 'session_' + Date.now();
                currentDrawnSessionId = null; // Eski çizimi unuttur, yenisi çizilsin
            }
            
            // Ayarı veritabanına ilet. Veritabanı bunu algılayıp yeni verileri "history" klasörüne işlemeye başlayacaktır.
            database.ref(`devices/${devEui}/settings`).update(updates).then(() => {
                // Güncelleme başarılı olursa menüyü tekrar yükle
                if (document.getElementById('view-history').style.display === 'flex') {
                    openHistoryView(devEui);
                }
            }).catch(err => {
                // Veritabanında izin hatası falan çıkarsa uyarı ver
                console.error("Firebase update error:", err);
                alert("Recording status could not be updated. Please check your Firebase permissions.");
            });
        };
    </script>
</body>
